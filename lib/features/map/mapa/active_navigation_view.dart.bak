                          if (_distanceToNextManeuverMeters != null) const SizedBox(height: 6),
                          if (_distanceToNextManeuverMeters != null) Text('${_distanceToNextManeuverMeters!.round()} m', style: const TextStyle(color: Colors.white70, fontSize: 14)),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),

          Positioned(
            right: 16,
            bottom: overlayBottom,
            child: Material(
              elevation: 6,
              color: Colors.transparent,
              borderRadius: BorderRadius.circular(999),
              child: Container(
