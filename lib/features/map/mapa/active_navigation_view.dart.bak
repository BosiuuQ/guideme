/// --- Helper functions moved to top-level so they can be used in compute() isolate ---
double _haversineMetersIsolate(double lat1, double lon1, double lat2, double lon2) {
  const R = 6371000.0;
  final dLat = (lat2 - lat1) * (pi / 180.0);
  final dLon = (lon2 - lon1) * (pi / 180.0);
  final a = (sin(dLat / 2) * sin(dLat / 2)) +
      cos(lat1 * (pi / 180.0)) *
          cos(lat2 * (pi / 180.0)) *
          (sin(dLon / 2) * sin(dLon / 2));
  final c = 2 * atan2(sqrt(a), sqrt(1 - a));
  return R * c;
}

Map<String, double> _projectOnSegmentIsolate(double plat, double plon, double al, double alon, double bl, double blon) {
  final vx = blon - alon;
  final vy = bl - al;
  final wx = plon - alon;
  final wy = plat - al;
  final denom = vx * vx + vy * vy;
  double t = 0.0;
  if (denom > 0.0) {
    t = (wx * vx + wy * vy) / denom;
    if (t < 0) t = 0.0;
    if (t > 1) t = 1.0;
  }
  final projLat = al + vy * t;
  final projLon = alon + vx * t;
  return {'lat': projLat, 'lon': projLon, 't': t};
}

double _bearingIsolate(double lat1, double lon1, double lat2, double lon2) {
  final phi1 = lat1 * (pi / 180.0);
  final phi2 = lat2 * (pi / 180.0);
  final dLon = (lon2 - lon1) * (pi / 180.0);
  final y = sin(dLon) * cos(phi2);
  final x = cos(phi1) * sin(phi2) - sin(phi1) * cos(phi2) * cos(dLon);
  final br = atan2(y, x) * 180.0 / pi;
  return (br + 360.0) % 360.0;
}

Map<String, dynamic> _navComputeIsolate(Map args) {
  final coords = (args['coords'] as List).cast<List>().map((e) => (e as List).map((x) => (x as num).toDouble()).toList()).toList();
  final double plat = (args['plat'] as num).toDouble();
  final double plon = (args['plon'] as num).toDouble();
  if (coords.isEmpty) {
    return {'found': false, 'bestDist': double.infinity, 'instr': 'Continue', 'foundDist': 0.0};
  }
  double bestDist = double.infinity;
  int bestSeg = 0;
  double bestT = 0.0;
  for (int i = 0; i < coords.length - 1; i++) {
    final a = coords[i];
    final b = coords[i + 1];
    final proj = _projectOnSegmentIsolate(plat, plon, a[0], a[1], b[0], b[1]);
    final d = _haversineMetersIsolate(plat, plon, proj['lat']!, proj['lon']!);
    if (d < bestDist) {
      bestDist = d;
      bestSeg = i;
      bestT = proj['t']!;
    }
  }

  String instr = 'Continue';
  double accumulated = 0.0;
  double lastBearing = _bearingIsolate(coords[bestSeg][0], coords[bestSeg][1], coords[bestSeg + 1][0], coords[bestSeg + 1][1]);
  for (int i = bestSeg; i < coords.length - 1; i++) {
    final a = coords[i];
    final b = coords[i + 1];
    final br = _bearingIsolate(a[0], a[1], b[0], b[1]);
    final diff = ((br - lastBearing + 540) % 360) - 180;
    final absdiff = diff.abs();
    final segDist = _haversineMetersIsolate(a[0], a[1], b[0], b[1]);
    accumulated += segDist;
    if (absdiff > 30 && accumulated > 15) {
      instr = diff > 0 ? 'Turn right' : 'Turn left';
      break;
    }
    lastBearing = br;
    if (accumulated > 200) break;
  }
  final end = coords.last;
  final distToEnd = _haversineMetersIsolate(plat, plon, end[0], end[1]);
  return {'found': true, 'bestDist': bestDist, 'instr': instr, 'foundDist': bestDist, 'distToEnd': distToEnd};
}

class ActiveNavigationView extends StatefulWidget {
  final mb.LatLng origin;
  final mb.LatLng destination;
  final String title;
  final List<List<double>> routeCoords;
  final double? durationSeconds;

  const ActiveNavigationView({
    Key? key,
    required this.origin,
    required this.destination,
    required this.title,
    required this.routeCoords,
    this.durationSeconds,
  }) : super(key: key);

  @override
  State<ActiveNavigationView> createState() => _ActiveNavigationViewState();
}

class _ActiveNavigationViewState extends State<ActiveNavigationView> with SingleTickerProviderStateMixin {
  bool _arrived = false;

  Timer? _rerouteTimer;
  static const String _mapboxToken = String.fromEnvironment('MAPBOX_ACCESS_TOKEN', defaultValue: 'pk.eyJ1IjoiYm9zaXV1cSIsImEiOiJjbWI2dDU0c3AwMzV4MnFxcjhlOWVraHZwIn0.IbQtOAFV1MKkx7id3RwtIg');
  List<List<double>>? _activeRouteCoords;
  DateTime? _lastRerouteAt;
  bool _isRerouting = false;

  late MapLogicHandler _mapLogic;
  String? _nextNavInstruction;
  double? _distanceToNextManeuverMeters;
  int _navComputeCounter = 0;

  double _speedKmh = 0.0;
  double _bearing = 0.0;
  bool _lineAdded = false;

  final GlobalKey _bottomKey = GlobalKey();
  double _bottomWidgetHeight = 0.0;

  @override
  void initState() {
    super.initState();
    _mapLogic = MapLogicHandler();
    _mapLogic.tickerProvider = this;
    _mapLogic.onUpdate = () {
      try {
        final v = _mapLogic.currentSpeedKmh;
        final b = _mapLogic.currentBearing;
        if (mounted) {
          setState(() {
            _speedKmh = double.parse(v.toStringAsFixed(1));
            _bearing = b;
          });
        }
      } catch (_) {}
      try {
        _updateNavigationHints();
      } catch (_) {}
    };
    WidgetsBinding.instance.addPostFrameCallback((_) => _measureBottomWidget());
    _mapLogic.start();

    try {
      _rerouteTimer?.cancel();
      _rerouteTimer = Timer.periodic(const Duration(seconds: 2), (_) async {
        debugPrint('Reroute tick: displayPosition=${_mapLogic.displayPosition} bearing=${_mapLogic.currentBearing}');
        try {
          final pos = _mapLogic.displayPosition;
          if (pos == null) return;
          final bearing = _mapLogic.currentBearing;
          await _recalculateRoute(pos.latitude, pos.longitude, bearing);
        } catch (_) {}
      });
    } catch (_) {}

    try {
      if (widget.routeCoords.isNotEmpty) {
        _mb.MapboxNavigationBridge.startNavigation(widget.routeCoords);
      }
    } catch (_) {}
  }

  @override
  void dispose() {
    _mapLogic.dispose();
    _rerouteTimer?.cancel();
    super.dispose();
  }

  Future<void> _recalculateRoute(double plat, double plon, double preferBearing) async {
    if (_isRerouting) return;
    final now = DateTime.now();
    if (_lastRerouteAt != null && now.difference(_lastRerouteAt!).inSeconds < 2) return;
    _isRerouting = true;
    try {
      final origin = '$plon,$plat';
      final dest = '${widget.destination.longitude},${widget.destination.latitude}';
      final profile = 'driving-traffic';
      final url = 'https://api.mapbox.com/directions/v5/mapbox/' + profile + '/' + origin + ';' + dest +
          '?alternatives=false&geometries=geojson&overview=full&steps=true&access_token=' + _mapboxToken;
      debugPrint('Reroute: requesting ' + url);
      final res = await http.get(Uri.parse(url));
      if (res.statusCode != 200) {
        debugPrint('Reroute failed: status=${res.statusCode} body=${res.body}');
        if (res.statusCode == 401) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            try {
              ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Reroute failed: check MAPBOX token'), duration: Duration(seconds: 4)));
            } catch (_) {}
          });
        } else if (res.statusCode == 422) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            try {
              ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Reroute error 422: ' + (res.body.length > 300 ? res.body.substring(0, 300) : res.body)), duration: const Duration(seconds: 6)));
            } catch (_) {}
          });
        }
        _isRerouting = false;
        return;
      }

      final j = json.decode(res.body) as Map<String, dynamic>?;
      if (j == null) {
        _isRerouting = false;
        return;
      }
      final routes = j['routes'] as List<dynamic>?;
      if (routes == null || routes.isEmpty) {
        _isRerouting = false;
        return;
      }
      final r = routes.first as Map<String, dynamic>;
      final geom = r['geometry'] as Map<String, dynamic>?;
      final coords = (geom?['coordinates'] as List<dynamic>?)?.map((e) {
        return [(e[1] as num).toDouble(), (e[0] as num).toDouble()];
      }).toList();
      if (coords != null && coords.isNotEmpty) {
        if (mounted) {
          setState(() {
            _activeRouteCoords = List<List<double>>.from(coords);
            _lineAdded = false; // force re-draw
          });
        }
        WidgetsBinding.instance.addPostFrameCallback((_) => _addRouteLineIfNeeded());

        // arrival check
        try {
          final ctrlPos = _mapLogic.displayPosition;
          if (ctrlPos != null && (_activeRouteCoords != null && _activeRouteCoords!.isNotEmpty)) {
            final last = _activeRouteCoords!.last;
            final distToGoal = _haversineDistanceMeters(ctrlPos.latitude, ctrlPos.longitude, last[0], last[1]);
            debugPrint('Arrival check: distToGoal=' + distToGoal.toString());
            if (distToGoal <= 100.0) {
              try {
                _rerouteTimer?.cancel();
              } catch (_) {}
              if (mounted) {
                setState(() {
                  _arrived = true;
                });
              }
            }
          }
        } catch (e) {
          debugPrint('Arrival check error: ' + e.toString());
        }
      }
      _lastRerouteAt = DateTime.now();
    } catch (e, st) {
      debugPrint('Reroute exception: $e \n$st');
    } finally {
      _isRerouting = false;
    }
  }

  double _haversineDistanceMeters(double lat1, double lon1, double lat2, double lon2) {
    const R = 6371000.0;
    final phi1 = lat1 * (pi / 180.0);
    final phi2 = lat2 * (pi / 180.0);
    final dphi = (lat2 - lat1) * (pi / 180.0);
    final dlambda = (lon2 - lon1) * (pi / 180.0);
    final a = (sin(dphi / 2) * sin(dphi / 2)) + (cos(phi1) * cos(phi2) * sin(dlambda / 2) * sin(dlambda / 2));
    final c = 2 * atan2(sqrt(a), sqrt(1 - a));
    return R * c;
  }

  double _deg2rad(double d) => d * (pi / 180.0);
  double _rad2deg(double r) => r * (180.0 / pi);

  double _computeBearing(double lat1, double lon1, double lat2, double lon2) {
    final phi1 = _deg2rad(lat1);
    final phi2 = _deg2rad(lat2);
    final lambda1 = _deg2rad(lon1);
    final lambda2 = _deg2rad(lon2);
    final y = sin(lambda2 - lambda1) * cos(phi2);
    final x = cos(phi1) * sin(phi2) - sin(phi1) * cos(phi2) * cos(lambda2 - lambda1);
    var brng = (_rad2deg(atan2(y, x)) + 360.0) % 360.0;
    return brng;
  }

  Map<String, dynamic> _projectOnSegment(double plat, double plon, double alat, double alon, double blat, double blon) {
    final latRad = _deg2rad(plat);
    final xA = alon * cos(latRad);
    final xB = blon * cos(latRad);
    final xP = plon * cos(latRad);
    final yA = alat;
    final yB = blat;
    final yP = plat;
    final dx = xB - xA;
    final dy = yB - yA;
    final len2 = dx * dx + dy * dy;
    double t = 0.0;
    if (len2 > 1e-9) {
      t = ((xP - xA) * dx + (yP - yA) * dy) / len2;
      if (t < 0.0) t = 0.0;
      if (t > 1.0) t = 1.0;
    }
    final cx = xA + dx * t;
    final cy = yA + dy * t;
    final closestLat = cy;
    final closestLon = cx / cos(latRad);
    return {'lat': closestLat, 'lon': closestLon, 't': t};
  }

  void _updateNavigationHints() async {
    if (_arrived) return;
    _navComputeCounter++;
    if (_navComputeCounter % 2 != 0) return;

    final coords = _activeRouteCoords ?? widget.routeCoords;
    if (coords.isEmpty) {
      if (mounted) {
        setState(() {
          _nextNavInstruction = null;
          _distanceToNextManeuverMeters = null;
        });
      }
      return;
    }

    try {
      final args = {'coords': coords, 'plat': _mapLogic.displayPosition?.latitude ?? 0.0, 'plon': _mapLogic.displayPosition?.longitude ?? 0.0};
      final Map<String, dynamic> res = await compute(_navComputeIsolate, args);
      if (res != null) {
        final instr = res['instr'] as String? ?? 'Continue';
        final bestDist = (res['bestDist'] as num?)?.toDouble() ?? double.infinity;
        final distToEnd = (res['distToEnd'] as num?)?.toDouble() ?? double.infinity;
        if (distToEnd < 100.0 && !_arrived) {
          if (mounted) setState(() {
            _arrived = true;
          });
          return;
        }
        if (instr != _nextNavInstruction || (_distanceToNextManeuverMeters == null) || (bestDist - (_distanceToNextManeuverMeters ?? double.infinity)).abs() > 2.0) {
          if (mounted) {
            setState(() {
              _nextNavInstruction = instr;
              _distanceToNextManeuverMeters = bestDist;
            });
          }
        }
      }
    } catch (e) {
      debugPrint('Nav isolate error: $e');
    }
  }

  String _formatArrival() {
    final ds = widget.durationSeconds ?? 0.0;
    final arrival = DateTime.now().toLocal().add(Duration(seconds: ds.round()));
    final h = arrival.hour.toString().padLeft(2, '0');
    final m = arrival.minute.toString().padLeft(2, '0');
    return '$h:$m';
  }

  String _minutesLeft() {
    final ds = widget.durationSeconds ?? 0.0;
    final mins = (ds / 60.0).round();
    return '$mins min';
  }

  String _translateInstruction(String? instr) {
    if (instr == null) return 'Trasa';
    final s = instr.toLowerCase();
    if (s.contains('right')) return 'Skręć w prawo';
    if (s.contains('left')) return 'Skręć w lewo';
    if (s.contains('arrive')) return 'Dojazd na miejsce';
    if (s.contains('continue')) return 'Kontynuuj';
    if (s.contains('u-turn') || s.contains('u turn') || s.contains('uturn') || s.contains('u')) return 'Zawróć';
    if (s.contains('round') || s.contains('rondo') || s.contains('roundabout')) return 'Rondo';
    return instr[0].toUpperCase() + instr.substring(1);
  }

  Widget _instructionIcon(String? instr) {
    final double size = 24.0;
    if (instr == null) return Icon(Icons.navigation, color: Colors.white, size: size);
    final s = instr.toLowerCase();
    if (s.contains('right')) return Icon(Icons.arrow_forward, color: Colors.white, size: size);
    if (s.contains('left')) return Icon(Icons.arrow_back, color: Colors.white, size: size);
    if (s.contains('arrive')) return Icon(Icons.flag, color: Colors.white, size: size);
    if (s.contains('continue')) return Icon(Icons.navigation, color: Colors.white, size: size);
    if (s.contains('u-turn') || s.contains('u turn') || s.contains('uturn') || s.contains('u')) return Icon(Icons.rotate_left, color: Colors.white, size: size);
    if (s.contains('round') || s.contains('rondo') || s.contains('roundabout')) return Icon(Icons.loop, color: Colors.white, size: size);
    return Icon(Icons.navigation, color: Colors.white, size: size);
  }

  void _measureBottomWidget() {
    try {
      final ctx = _bottomKey.currentContext;
      if (ctx != null) {
        final size = ctx.size;
        if (size != null) {
          final h = size.height;
          if (h != _bottomWidgetHeight) {
            if (mounted) setState(() {
              _bottomWidgetHeight = h;
            });
          }
        }
      }
    } catch (_) {}
  }

  Future<void> _addRouteLineIfNeeded() async {
    if (_lineAdded) return;
    final ctrl = _mapLogic.controller;
    if (ctrl == null) return;
    final coords = _activeRouteCoords ?? widget.routeCoords;
    if (coords.isEmpty) return;
    try {
      try {
        await ctrl.clearLines(layerId: 'route_emissive_line');
      } catch (_) {}
      try {
        await ctrl.clearAnnotationLines();
      } catch (_) {}
      final lineCoords = coords.map((c) => mb.LatLng(c[0], c[1])).toList();
      await ctrl.addEmissiveLine(
        mb.LineOptions(
          geometry: lineCoords,
          lineColor: '#FF0092d2',
          lineWidth: 6.0,
        ),
        emissiveStrength: 1.5,
        layerId: 'route_emissive_line',
      );
      _lineAdded = true;
    } catch (e) {
      debugPrint('Error while adding navigation line: $e');
    }
  }

  Widget _buildMap() {
    return mb.MapboxMap(scrollGesturesEnabled: false, /*scroll-inserted*/
      accessToken: 'pk.eyJ1IjoiYm9zaXV1cSIsImEiOiJjbWI2dDU0c3AwMzV4MnFxcjhlOWVraHZwIn0.IbQtOAFV1MKkx7id3RwtIg',
      initialCameraPosition: mb.CameraPosition(target: widget.origin, zoom: 18, bearing: 0.0, tilt: 75.0),
      styleUri: 'mapbox://styles/bosiuuq/cmgf5xezs00i701sec30chpp0',
      onMapCreated: (controller) async {
        _mapLogic.onMapCreated(controller);
        WidgetsBinding.instance.addPostFrameCallback((_) => _addRouteLineIfNeeded());
      },
      myLocationEnabled: false,
      trackCameraPosition: true,
      onStyleLoadedCallback: () {
        WidgetsBinding.instance.addPostFrameCallback((_) => _addRouteLineIfNeeded());
      },
    );
  }

