import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/scheduler.dart';
import 'package:guide_me/mapbox_shim.dart' as mb;
import 'package:guide_me/mapbox_shim.dart';
import 'package:geolocator/geolocator.dart';

/// MapLogicHandler - listens to device location and updates the map controller.
/// It will add/update a single user-location symbol (using an asset icon when present)
/// and animate the camera smoothly to follow the user.
class MapLogicHandler {
  VoidCallback? onUpdate;
  TickerProvider? tickerProvider;

  mb.MapboxMapController? controller;
  mb.Symbol? _userSymbol;
  StreamSubscription<Position>? _posSub;

  /// optional latest known target location
  Position? targetLocation;

  MapLogicHandler({this.onUpdate, this.tickerProvider});

  /// Backwards-compatibility factory accepting positional args.
  factory MapLogicHandler.fromPositional([VoidCallback? onUpdate, TickerProvider? tickerProvider]) {
    return MapLogicHandler(onUpdate: onUpdate, tickerProvider: tickerProvider);
  }


  /// Called from the map widget when the map controller is ready.
  Future<void> onMapCreated(mb.MapboxMapController ctrl) async {
    controller = ctrl;
    // Try to initialize location listening
    _initLocationListening();
  }

  /// Dispose resources
  Future<void> dispose() async {
    await _posSub?.cancel();
    _posSub = null;
  }

  Future<void> _initLocationListening() async {
    try {
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        // location services are not enabled - we won't subscribe
        return;
      }
      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
      }
      if (permission == LocationPermission.denied || permission == LocationPermission.deniedForever) {
        // permission not granted
        return;
      }

      // Get current position once to quickly place the marker & center camera
      try {
        final p = await Geolocator.getCurrentPosition(desiredAccuracy: LocationAccuracy.best);
        await _processPosition(p, animateCamera: true, initial: true);
      } catch (e) {
        // ignore getting current position failure
      }

      // Subscribe to position stream for updates
      _posSub = Geolocator.getPositionStream(
        locationSettings: const LocationSettings(accuracy: LocationAccuracy.best, distanceFilter: 5),
      ).listen((pos) {
        _processPosition(pos);
      });
    } catch (e) {
      // ignore errors
    }
  }

  
  int _interpToken = 0;

  Future<void> _processPosition(Position pos, {bool animateCamera = false, bool initial = false}) async {
    if (controller == null) {
      // keep the last target
      targetLocation = pos;
      return;
    }

    targetLocation = pos;
    final LatLng target = LatLng(pos.latitude, pos.longitude);
    const double desiredZoom = 17.0;const double desiredZoom = 17.0; // zoom suited for driving

    try {
      // If no symbol yet, create and center immediately
      if (_userSymbol == null) {
        _userSymbol = await controller!.addSymbol(SymbolOptions(
          geometry: target,
          data: {'asset': 'assets/icons/marker.png'},
        ));
        // set camera immediately to user's location with desired zoom
        try {
          controller!.moveCameraImmediate(target, desiredZoom);
        } catch (e) {}
        onUpdate?.call();
        return;
      }

      // Cancel any running interpolation
      _interpToken++;
      final int myToken = _interpToken;

      // current position of symbol
      LatLng from = _userSymbol!.geometry ?? target;
      final double fromLat = from.latitude;
      final double fromLon = from.longitude;
      final double toLat = target.latitude;
      final double toLon = target.longitude;

      // Compute distance and adapt duration/steps for smoothness (faster for short moves)
      final double distanceMeters = Geolocator.distanceBetween(fromLat, fromLon, toLat, toLon);
      // base duration proportional to distance, clamp between 200ms and 1200ms
      final int durationMs = ( (distanceMeters / 10).clamp(200, 1200) ).toInt();
      final int stepMs = 40;
      final int steps = (durationMs / stepMs).clamp(3, 50).toInt();

       // zoom suited for driving

    try {
      // If no symbol yet, create and center immediately
      if (_userSymbol == null) {
        _userSymbol = await controller!.addSymbol(SymbolOptions(
          geometry: target,
          data: {'asset': 'assets/icons/marker.png'},
        ));
        // set camera immediately to user's location with desired zoom
        try {
          controller!.moveCameraImmediate(target, desiredZoom);
        } catch (e) {}
        onUpdate?.call();
        return;
      }

      // Cancel any running interpolation
      _interpToken++;
      final int myToken = _interpToken;

      // current position of symbol
      LatLng from = _userSymbol!.geometry ?? target;
      final double fromLat = from.latitude;
      final double fromLon = from.longitude;
      final double toLat = target.latitude;
      final double toLon = target.longitude;

      // Compute distance and adapt duration/steps for smoothness (faster for short moves)
      final double distanceMeters = Geolocator.distanceBetween(fromLat, fromLon, toLat, toLon);
      // base duration proportional to distance, clamp between 200ms and 1200ms
      final int durationMs = ( (distanceMeters / 10).clamp(200, 1200) ).toInt();
      final int stepMs = 40;
      final int steps = (durationMs / stepMs).clamp(3, 50).toInt();

      for (int i = 1; i <= steps; i++) {
        // If a new interpolation started, abort
        if (myToken != _interpToken) return;
        final double t = i / steps;
        final double curLat = fromLat + (toLat - fromLat) * t;
        final double curLon = fromLon + (toLon - fromLon) * t;
        final LatLng intermediate = LatLng(curLat, curLon);

        // update symbol to intermediate position
        try {
          try { controller!.updateSymbolImmediate(_userSymbol!, intermediate); } catch (e) {}
        } catch (e) {}

        // move camera immediately to intermediate so it follows the marker tightly
        try {
          controller!.moveCameraImmediate(intermediate, desiredZoom);
        } catch (e) {}

        // small delay between steps to create smooth motion
        await Future.delayed(Duration(milliseconds: stepMs));
      }

      // ensure final exact position
      try {
        try { controller!.updateSymbolImmediate(_userSymbol!, target); } catch (e) {}
        controller!.moveCameraImmediate(target, desiredZoom);
      } catch (e) {}

      // notify UI
      onUpdate?.call();
    } catch (e) {
      // ignore runtime errors (e.g. controller not ready)
    }
  }


  /// If some other part of the app wants to move camera to a previously set target
  Future<void> moveToTarget({double zoom = 16}) async {
    if (controller == null || targetLocation == null) return;
    await controller!.animateCamera(mb.CameraPosition(target: mb.LatLng(targetLocation!.latitude, targetLocation!.longitude), zoom: zoom));
  }

  /// Backwards-compatible stub for legacy callers that expect a speedometer widget.
  /// Returns an empty sized box — override later if you need a real widget.
  Widget buildSpeedometer() {
    return const SizedBox.shrink();
  }

}
